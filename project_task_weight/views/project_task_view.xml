<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="weight" />
            </field>
        </field>
    </record>
    <record id="quick_create_task_form" model="ir.ui.view">
        <field name="name">project.task.form.quick_create</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.quick_create_task_form" />
        <field name="arch" type="xml">
            <field name="project_id" position="before">
                <field name="weight" />
            </field>
        </field>
    </record>

    <record id="view_task_weight_search" model="ir.ui.view">
        <field name="name">project.scrum.sprint.task</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="weight" />
            </field>
            <filter name="project" position="after">
                <filter string="Weight" name="group_by_weight" context="{'group_by':'weight'}" />
            </filter>
        </field>
    </record>

    <!-- Project Task Kanban View -->

    <!-- 20.0 moved the kanban fields into project.view_task_card; the card has
         no partner_id field, so weight is placed after the task name. The
         progressbar and the card menu moved too, and are not touched here. -->
    <record model="ir.ui.view" id="view_task_card_weight">
        <field name="name">project.task.card.weight</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_card" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="weight" />
            </xpath>
        </field>
    </record>
    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">project.task.tree</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="stage_id" position="before">
                <field name="weight" optional="show" />
            </field>
        </field>
    </record>
    <record id="view_task_calendar" model="ir.ui.view">
        <field name="name">project.task.calendar</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_calendar" />
        <field name="arch" type="xml">
            <field name="stage_id" position="before">
                <field name="weight" optional="show" />
            </field>
        </field>
    </record>

</odoo>
