<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================
             RAPPORT: Sprint Task Test Report
             ============================================================ -->
        <record id="report_sprint_task_test" model="ir.actions.report">
            <field name="name">Sprint Task Test Report</field>
            <field name="model">project.scrum.sprint</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">project_sprint_module.report_sprint_task_test_template</field>
            <field name="report_file">project_sprint_module.report_sprint_task_test_template</field>
            <field name="print_report_name">"Sprint_Tasks_%s" % object.name</field>
            <field name="attachment_use" eval="True"/>
            <field name="attachment">"Sprint_Tasks_" + object.name.replace(" ","_") + ".pdf"</field>
            <field name="binding_model_id" ref="project_scrum.model_project_scrum_sprint"/>
            <field name="binding_type">report</field>
        </record>

        <!-- ============================================================
             QWEB TEMPLATE
             ============================================================ -->
        <template id="report_sprint_task_test_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                        <!-- Huvudrubrik: Sprint-namn -->
                        <h1 t-field="doc.name"/>

                        <!-- Projekt + start/stop -->
                        <p style="color: #555; margin-bottom: 16px;">
                            <t t-if="doc.project_id">
                                <t t-esc="doc.project_id.name"/>
                            </t>
                            <t t-if="doc.date_start or doc.date_stop">
                                <t t-if="doc.project_id"> | </t>
                                <t t-if="doc.date_start">
                                    <t t-esc="doc.date_start"/>
                                </t>
                                <t t-if="doc.date_start and doc.date_stop"> — </t>
                                <t t-if="doc.date_stop">
                                    <t t-esc="doc.date_stop"/>
                                </t>
                            </t>
                        </p>

                        <!-- Aktiviteter för test -->
                        <t t-set="tasks" t-value="doc.task_ids.filtered(lambda t: t.is_closed)"/>
                        <h2 style="margin-top: 24px;">Aktiviteter för test</h2>
                        <br/>
                        <t t-if="tasks">
                            <t t-foreach="tasks" t-as="task">
                                <h3 style="margin-top: -8px;">
                                    <t t-esc="task.name"/>
                                </h3>
                                <p style="margin-bottom: 8px;">
                                    <t t-if="task.description">
                                        <t t-set="html" t-value="task.description or ''"/>
                                        <t t-set="idx" t-value="html.find('<p>---</p>')"/>
                                        <t t-if="idx >= 0">
                                            <t t-out="html[:idx]"/>
                                        </t>
                                        <t t-else="">
                                            <t t-set="idx2" t-value="html.find('---')"/>
                                            <t t-if="idx2 >= 0">
                                                <t t-out="html[:idx2]"/>
                                            </t>
                                            <t t-else="">
                                                <t t-out="html"/>
                                            </t>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <span style="color: #999; font-style: italic;">No description</span>
                                    </t>
                                </p>
                                <p style="margin-bottom: 30px; color: #555; font-size: 0.9em;">
                                    <t t-if="task.module_ids">
                                        <t t-esc="', '.join(task.module_ids.mapped('technical_name'))"/>
                                    </t>
                                    <t t-else="">
                                        <span style="color: #ccc;">—</span>
                                    </t>
                                </p>
                            </t>
                        </t>
                        <t t-else="">
                            <p style="color: #999; font-style: italic;">Inga klara aktiviteter i denna sprint.</p>
                        </t>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
