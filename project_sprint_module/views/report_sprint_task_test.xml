<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================
             RAPPORT: Sprint Task Test Report
             ============================================================ -->
        <record id="report_sprint_task_test" model="ir.actions.report">
            <field name="name">Sprint Task Test Report</field>
            <field name="model">project.scrum.sprint</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">project_sprint_module.report_sprint_task_test_template</field>
            <field name="report_file">project_sprint_module.report_sprint_task_test_template</field>
            <field name="print_report_name">"Sprint_Tasks_%s" % object.name</field>
            <field name="attachment_use" eval="True"/>
            <field name="attachment">"Sprint_Tasks_" + object.name.replace(" ","_") + ".pdf"</field>
            <field name="binding_model_id" ref="project_scrum.model_project_scrum_sprint"/>
            <field name="binding_type">report</field>
        </record>

        <!-- ============================================================
             QWEB TEMPLATE
             ============================================================ -->
        <template id="report_sprint_task_test_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id">
                        <h1 t-field="doc.name"/>
                        <p style="color: #555; margin-bottom: 16px;">
                            <t t-if="doc.project_id"><t t-esc="doc.project_id.name"/></t>
                            <t t-if="doc.date_start or doc.date_stop">
                                <t t-if="doc.project_id"> | </t>
                                <t t-if="doc.date_start"><t t-esc="doc.date_start"/></t>
                                <t t-if="doc.date_start and doc.date_stop"> — </t>
                                <t t-if="doc.date_stop"><t t-esc="doc.date_stop"/></t>
                            </t>
                        </p>
                        <t t-set="tasks" t-value="doc.task_ids.filtered(lambda t: t.stage_id and 'Test' in t.stage_id.name)"/>
                        <h2 style="margin-top: 24px;">Aktiviteter för test</h2>
                        <br/>
                        <t t-if="tasks">
                            <t t-foreach="tasks" t-as="task">
                                <h3><t t-esc="task.name"/></h3>
                                <p style="margin-bottom: 8px;">
                                    <t t-if="task.description">
                                        <t t-set="html" t-value="task.description or ''"/>
                                        <t t-set="idx" t-value="html.find('---')"/>
                                        <t t-if="idx >= 0"><t t-out="html[:idx]"/></t>
                                        <t t-else=""><t t-out="html"/></t>
                                    </t>
                                    <t t-else=""><span style="color: #999; font-style: italic;">No description</span></t>
                                </p>
                                <p style="margin-bottom: 30px; color: #555; font-size: 0.9em;">
                                    <t t-if="task.module_ids"><t t-esc="', '.join(task.module_ids.mapped('technical_name'))"/></t>
                                    <t t-else=""><span style="color: #ccc;">—</span></t>
                                </p>

                                <!-- AI Use Case -->
                                <t t-if="task.ai_usecase or task.ai_usecase_mermaid">
                                    <div style="margin: 12px 0 24px 0; padding: 12px; border-left: 4px solid #4A90D9; background: #f0f4f8;">
                                        <p style="font-weight: bold; color: #4A90D9; margin-bottom: 10px;">AI Use Case</p>
                                        <t t-if="task.ai_usecase">
                                            <div style="color: #444; font-size: 0.9em; margin-bottom: 12px; line-height: 1.5;" t-field="task.ai_usecase"/>
                                        </t>
                                        <t t-if="task.ai_usecase_mermaid">
                                            <p style="font-weight: bold; font-size: 0.85em; color: #666; margin: 8px 0 4px 0;">Mermaid Diagram:</p>
                                            <div style="padding: 10px; background: #ffffff; border: 1px solid #d0d7de; border-radius: 4px; font-family: 'Courier New', monospace; font-size: 0.78em; line-height: 1.4; white-space: pre-wrap; overflow-x: auto; color: #333;"><t t-esc="task.ai_usecase_mermaid"/></div>
                                        </t>
                                    </div>
                                </t>
                            </t>
                        </t>
                        <t t-else="">
                            <p style="color: #999; font-style: italic;">Inga klara aktiviteter i denna sprint.</p>
                        </t>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
