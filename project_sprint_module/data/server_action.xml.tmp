<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_scan_fs_repos" model="ir.actions.server">
            <field name="name">Scan Filesystem for Sprint Repos</field>
            <field name="model_id" ref="project_sprint_module.model_sprint_repo"/>
            <field name="state">code</field>
            <field name="code">
action = env['sprint.module'].scan_filesystem()
</field>
        </record>

        <record id="ir_value_scan_fs_repos" model="ir.values">
            <field name="name">Scan Filesystem</field>
            <field name="model">sprint.repo</field>
            <field name="key2">client_action_multi</field>
            <field name="value" eval="'ir.actions.server,%s' % ref('action_scan_fs_repos')"/>
        </record>
    </data>
</odoo>
